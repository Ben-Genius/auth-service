// =============================================================================
// PRISMA SCHEMA — Auth-as-a-Service (Multi-Tenant)
// =============================================================================
// This is a completely different architecture from single-app auth.
//
// ARCHITECTURE OVERVIEW:
//
//   User (signs up via BetterAuth on the portal)
//     └── Project (an "app" they want to add auth to)
//           └── ServiceUser (end-users of THAT specific app)
//                 └── Otp (verification codes for that end-user)
//
// WHY MULTI-TENANT?
// An auth service must isolate data per developer/app.
// Developer A's users must NEVER be visible to Developer B.
// The "projectId" on every ServiceUser enforces this isolation.
//
// DATA FLOW:
// 1. User signs up on the portal via BetterAuth → gets a BetterAuth session
// 2. User creates a Project → gets an API key
// 3. Developer's app calls /api/v1/auth/register with X-API-Key header
// 4. Our service creates a ServiceUser scoped to that project
// 5. Developer's app receives a JWT back — user is authenticated!
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// BETTERAUTH CORE TABLES
// =============================================================================
// These tables are managed by BetterAuth for the portal authentication.
// Developers sign in via BetterAuth's /api/auth/* endpoints.
// =============================================================================
model user {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  emailVerified        Boolean   @default(false)
  image                String?
  phoneNumber          String?                           // phoneNumber plugin
  phoneNumberVerified  Boolean   @default(false)          // phoneNumber plugin
  username             String?   @unique                  // username plugin
  role                 String?   @default("user")         // admin plugin
  banned               Boolean?  @default(false)          // admin plugin
  banReason            String?                           // admin plugin
  banExpires           DateTime?                          // admin plugin
  twoFactorEnabled     Boolean?  @default(false)          // twoFactor plugin
  isAnonymous          Boolean?  @default(false)          // anonymous plugin
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  session    session[]
  account    account[]
  projects   Project[]
  twoFactor  twoFactor[]
  member     member[]

  @@map("as_user")
}

model session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("as_session")
}

model account {
  id                   String    @id @default(cuid())
  accountId            String
  providerId           String
  userId               String
  accessToken          String?
  refreshToken         String?
  idToken              String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("as_account")
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("as_verification")
}

// =============================================================================
// BETTERAUTH PLUGIN TABLES
// =============================================================================
// These are managed by BetterAuth plugins (twoFactor, organization).
// =============================================================================

model twoFactor {
  id                       String    @id @default(cuid())
  secret                   String
  backupCodes              String
  userId                   String
  verified                 Boolean?  @default(true)
  failedVerificationCount  Int?      @default(0)
  lockedUntil              DateTime?

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("as_two_factor")
}

model organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  metadata  String?

  member     member[]
  invitation invitation[]

  @@map("as_organization")
}

model member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("as_member")
}

model invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String
  status         String   @default("pending")
  teamId         String?
  inviterId      String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("as_invitation")
}

// =============================================================================
// PROJECT — Represents a developer's application
// =============================================================================
// Each project gets its own API key. ServiceUsers are scoped to a project.
// This is the "tenant" in "multi-tenant". Now linked to BetterAuth user.
// =============================================================================
model Project {
  id        String   @id @default(cuid())
  name      String                              // e.g., "My SaaS App"
  userId    String                              // BetterAuth user who owns this
  apiKey    String   @unique                    // the key other apps use to call our API
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         user          @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceUsers ServiceUser[]
  otps         Otp[]

  @@map("as_project")
}

// =============================================================================
// SERVICEUSER — End-users of a developer's application
// =============================================================================
// These are NOT users of our portal. They are users of the apps that
// developers build. Each ServiceUser belongs to exactly one Project.
//
// WHY "ServiceUser" AND NOT "User"?
// To avoid confusion. "User" usually means "person using our app".
// "ServiceUser" makes it clear these are users of the SERVICE we provide.
// =============================================================================
model ServiceUser {
  id            String   @id @default(cuid())
  projectId     String                              // which project this user belongs to
  email         String                              // email within this project's scope
  name          String?
  passwordHash  String
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  otps    Otp[]

  // A user's email must be unique WITHIN a project, but can exist
  // in other projects (different apps might have the same user).
  @@unique([projectId, email])
  @@map("as_service_user")
}

// =============================================================================
// OTP — One-time verification codes
// =============================================================================
// Same as before, but now scoped to a project via the ServiceUser relation.
// =============================================================================
model Otp {
  id        String   @id @default(cuid())
  projectId String                              // denormalized for fast lookups
  userId    String
  code      String                              // bcrypt-hashed
  purpose   String                              // "VERIFY_EMAIL"
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceUser ServiceUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("as_otp")
}